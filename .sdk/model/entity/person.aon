# Entity: person

main: kit: entity: person: {

  alias: field: {}

  fields: [
    {
      name: "cases"
      req: false
      short: "List of cases associated with the person"
      type: "`$ARRAY`"
    }
    {
      name: "details"
      req: false
      short: "Additional details about the person"
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      short: "Unique identifier for the person"
      type: "`$INTEGER`"
    }
    {
      name: "name"
      req: false
      short: "Full name of the person"
      type: "`$STRING`"
    }
    {
      name: "position"
      req: false
      short: "Position or role of the person (e.g., judge, investigator, prosecutor)"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "person"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                kind: "query"
                name: "case_navalny"
                orig: "case_navalny"
                reqd: false
                type: "`$BOOLEAN`"
              }
              {
                kind: "query"
                name: "internet_blocking"
                orig: "internet_blocking"
                reqd: false
                type: "`$BOOLEAN`"
              }
            ]
          }
          method: "GET"
          orig: "/persons/"
          segments: [
            {
              lit: "persons"
            }
          ]
          select: {
            exist: [
              "case_navalny"
              "internet_blocking"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.results`"
          }
        }
      ]
    }
  }



}
