  id: {
    field: "id"
    name: "id"
  }

  name: "person"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /persons/"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                k: "query"
